# Soundcharts (server-only — never expose to the browser)
SOUNDCHARTS_API_BASE_URL=https://customer.api.soundcharts.com
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# Resend mailing list (server-only)
# Falls back to EMAIL_RESEND_API_KEY in sibling ../auria-platform/.env during local dev.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Legacy audiences API — use RESEND_SEGMENT_ID when possible
RESEND_AUDIENCE_ID=
